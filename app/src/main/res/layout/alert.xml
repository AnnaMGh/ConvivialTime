<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBlackTransparent"
    android:gravity="center"
    android:orientation="vertical">


    <RelativeLayout
        android:id="@+id/rl_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="50dp"
        android:background="@drawable/round_corners_blue">

        <TextView
            android:id="@+id/txt_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_margin="30dp"
            fontPath="fonts/Geometry_Soft_Pro-Bold_N.otf"
            tools:ignore="MissingPrefix"
            android:gravity="center"
            android:text="@string/do_you_want_to_cancel_the_game"
            android:textColor="@color/colorWhite"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_below="@id/txt_message">

            <TextView
                android:id="@+id/txt_yes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                fontPath="fonts/Geometry_Soft_Pro-Bold_N.otf"
                tools:ignore="MissingPrefix"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/yes"
                android:textColor="@color/colorWhite"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txt_no"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                fontPath="fonts/Geometry_Soft_Pro-Bold_N.otf"
                tools:ignore="MissingPrefix"
                android:gravity="center"
                android:text="@string/no"
                android:textColor="@color/colorWhite"
                android:textSize="18sp" />

        </LinearLayout>


    </RelativeLayout>


</LinearLayout>